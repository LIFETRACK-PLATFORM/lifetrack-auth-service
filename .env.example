# Copia este archivo como .env y completa los valores reales.
PORT=3001
NATS_SERVERS="nats://localhost:4222"
RESEND_API_KEY="xxxxx"
# Requiere un dominio propio verificado en resend.com/domains: con el
# remitente sandbox por defecto (onboarding@resend.dev), Resend SOLO entrega
# correos a la dirección dueña de la API key, no a usuarios reales.
RESEND_FROM_EMAIL="LifeTrack <onboarding@resend.dev>"
DATABASE_URL="postgresql://user:password@localhost:5432/auth_db?schema=public"

# Generar con: openssl rand -hex 32
JWT_SECRET=

JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=12

# Bloqueo de cuenta tras intentos fallidos de login
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION="15m"

# Reset de contraseña
# Nota: el frontend en dev corre en el puerto 3002 (ver frontend/package.json,
# "next dev -p 3002"), no en 3000 (ese puerto lo usa api-gateway).
PASSWORD_RESET_TOKEN_TTL="15m"
PASSWORD_RESET_URL_BASE="http://localhost:3002/reset-password"

# Verificación de email
EMAIL_VERIFICATION_TOKEN_TTL="24h"
EMAIL_VERIFICATION_URL_BASE="http://localhost:3002/confirm-email"
