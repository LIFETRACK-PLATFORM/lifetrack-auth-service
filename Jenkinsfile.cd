pipeline {
  agent any

  environment {
    IMAGE = "ghcr.io/lifetrack-platform/auth-service"
    VPS   = "95.216.164.54"
    VPS_USER = "ricardo"
  }

  stages {
    stage("Docker Build") {
      steps {
        sh "docker build -t ${IMAGE}:${env.BUILD_NUMBER} ."
      }
    }

    stage("Docker Push") {
      steps {
        withCredentials([usernamePassword(credentialsId: 'github-token-userpass', usernameVariable: 'GH_USER', passwordVariable: 'GH_TOKEN')]) {
          sh "echo ${GH_TOKEN} | docker login ghcr.io -u ${GH_USER} --password-stdin"
          sh "docker push ${IMAGE}:${env.BUILD_NUMBER}"
        }
      }
    }

    stage("Migrate") {
      steps {
        sshagent(['vps-ssh']) {
          sh """
            ssh -o StrictHostKeyChecking=no ${VPS_USER}@${VPS} '
              docker run --rm \
                --network lifetrack-net \
                --env-file /home/ricardo/lifetrack-infra/envs/auth-service.env \
                ${IMAGE}:${env.BUILD_NUMBER} \
                node_modules/.bin/prisma migrate deploy --schema=prisma/schema.prisma
            '
          """
        }
      }
    }

    stage("Deploy") {
      steps {
        sshagent(['vps-ssh']) {
          sh """
            ssh -o StrictHostKeyChecking=no ${VPS_USER}@${VPS} '
              docker stop auth-service || true
              docker rm auth-service || true
              docker run -d --name auth-service \
                --network lifetrack-net \
                --restart unless-stopped \
                --env-file /home/ricardo/lifetrack-infra/envs/auth-service.env \
                ${IMAGE}:${env.BUILD_NUMBER}
            '
          """
        }
      }
    }
  }

  post {
    success {
      echo "Deploy OK - auth-service #${env.BUILD_NUMBER}"
    }
    failure {
      echo "Deploy FAILED - auth-service #${env.BUILD_NUMBER}"
    }
  }
}
