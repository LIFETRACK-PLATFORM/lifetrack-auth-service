pipeline {
  agent any

  stages {
    stage("Docker Build") {
      steps {
        sh "docker build -t auth-service:${env.BUILD_NUMBER} ."
      }
    }

    stage("Migrate") {
      steps {
        sh """
          docker run --rm \
            --network lifetrack-net \
            --env-file /home/ricardo/lifetrack-infra/envs/auth-service.env \
            auth-service:${env.BUILD_NUMBER} \
            npx prisma migrate deploy
        """
      }
    }

    stage("Deploy") {
      steps {
        sh "docker network create lifetrack-net || true"
        sh "docker stop auth-service || true"
        sh "docker rm auth-service || true"
        sh """
          docker run -d --name auth-service \
            --network lifetrack-net \
            --restart unless-stopped \
            --env-file /home/ricardo/lifetrack-infra/envs/auth-service.env \
            auth-service:${env.BUILD_NUMBER}
        """
      }
    }
  }

  post {
    success {
      echo "Deploy OK - auth-service #${env.BUILD_NUMBER}"
    }
    failure {
      echo "Deploy FAILED - auth-service #${env.BUILD_NUMBER}"
    }
  }
}
