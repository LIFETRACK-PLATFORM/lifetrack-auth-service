pipeline {
  agent any

  options {
    disableConcurrentBuilds()
  }

  environment {
    IMAGE = "ghcr.io/lifetrack-platform/auth-service"
    VPS   = "95.216.164.54"
    VPS_USER = "ricardo"
  }

  stages {
    stage("Docker Build") {
      steps {
        sh "docker buildx build --builder lifetrack-builder -t ${IMAGE}:latest --load ."
      }
    }

    stage("Docker Push") {
      steps {
        withCredentials([usernamePassword(credentialsId: 'github-token-userpass', usernameVariable: 'GH_USER', passwordVariable: 'GH_TOKEN')]) {
          sh "echo ${GH_TOKEN} | docker login ghcr.io -u ${GH_USER} --password-stdin"
          sh "docker push ${IMAGE}:latest"
        }
      }
    }

    stage("Docker Login (VPS)") {
      steps {
        withCredentials([usernamePassword(credentialsId: 'github-token-userpass', usernameVariable: 'GH_USER', passwordVariable: 'GH_TOKEN')]) {
          sshagent(['vps-ssh']) {
            sh """
              ssh -o StrictHostKeyChecking=no ${VPS_USER}@${VPS} '
                echo ${GH_TOKEN} | docker login ghcr.io -u ${GH_USER} --password-stdin
              '
            """
          }
        }
      }
    }

    stage("Migrate") {
      steps {
        sshagent(['vps-ssh']) {
          sh """
            ssh -o StrictHostKeyChecking=no ${VPS_USER}@${VPS} '
              docker pull ${IMAGE}:latest
              docker run --rm \
                --network lifetrack-net \
                --env-file /home/ricardo/lifetrack-infra/envs/auth-service.env \
                ${IMAGE}:latest \
                node_modules/.bin/prisma migrate deploy --schema=prisma/schema.prisma
            '
          """
        }
      }
    }

    stage("Deploy") {
      steps {
        sshagent(['vps-ssh']) {
          sh """
            ssh -o StrictHostKeyChecking=no ${VPS_USER}@${VPS} '
              docker stop auth-service || true
              docker rm auth-service || true
              docker run -d --name auth-service \
                --network lifetrack-net \
                --restart unless-stopped \
                --env-file /home/ricardo/lifetrack-infra/envs/auth-service.env \
                ${IMAGE}:latest
              docker image prune -f
            '
          """
        }
      }
    }
  }

  post {
    always {
      sh 'docker image prune -af || true'
      sh 'docker buildx prune -af --builder lifetrack-builder || true'
    }
    success {
      echo "Deploy OK - auth-service #${env.BUILD_NUMBER}"
    }
    failure {
      echo "Deploy FAILED - auth-service #${env.BUILD_NUMBER}"
    }
  }
}
